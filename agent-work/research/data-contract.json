{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HexCrawl research records",
  "description": "Required structure for future research facts, decisions and handoffs; existing rule matrices use their established schema. Rules-analysis v2: new or aligned game records additionally use rule_analysis_entry_v2, rule_source_coverage_v2 and rule_analysis_quality_report_v2 under rule-analysis-standard.md. Legacy records are not silently migrated or accepted.",
  "$defs": {
    "observation": {
      "type": "object",
      "required": [
        "id",
        "game_ids",
        "source",
        "observed_fact",
        "interpretation",
        "signal_type",
        "quantity",
        "unit",
        "period",
        "geography_language",
        "author_project_key",
        "duplicate_of",
        "access_level",
        "scenario_relevance",
        "limitations",
        "observed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "game_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "object",
          "required": [
            "url_or_ref",
            "locator",
            "published_at"
          ],
          "properties": {
            "url_or_ref": {
              "type": "string"
            },
            "locator": {
              "type": [
                "string",
                "null"
              ]
            },
            "published_at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "observed_fact": {
          "type": "string"
        },
        "interpretation": {
          "type": "string"
        },
        "signal_type": {
          "type": "string"
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "geography_language": {
          "type": [
            "string",
            "null"
          ]
        },
        "author_project_key": {
          "type": "string"
        },
        "duplicate_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_level": {
          "enum": [
            "full_text",
            "metadata",
            "search_snippet",
            "unavailable"
          ]
        },
        "scenario_relevance": {
          "type": "array",
          "items": {
            "enum": [
              "create",
              "develop",
              "play_now",
              "popularity_only",
              "unknown"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rating_proposal": {
      "type": "object",
      "required": [
        "proposal_id",
        "version",
        "status",
        "base_ranking_ref",
        "base_ranking_sha",
        "method_version_before",
        "method_version_candidate",
        "affected_games",
        "before_after",
        "evidence_refs",
        "reason",
        "uncertainty_and_sensitivity",
        "cohort_impact",
        "owner_approval_ref"
      ],
      "properties": {
        "proposal_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "awaiting_owner_approval",
            "approved",
            "rejected",
            "superseded",
            "applied"
          ]
        },
        "base_ranking_ref": {
          "type": "string"
        },
        "base_ranking_sha": {
          "type": "string"
        },
        "method_version_before": {
          "type": "string"
        },
        "method_version_candidate": {
          "type": "string"
        },
        "affected_games": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "before_after": {
          "type": "array"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "uncertainty_and_sensitivity": {
          "type": "string"
        },
        "cohort_impact": {
          "type": "string"
        },
        "owner_approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "product_task_handoff": {
      "type": "object",
      "required": [
        "task_id",
        "title",
        "status",
        "problem",
        "benefit",
        "game_editions",
        "primary_scenario",
        "layer",
        "requirement_refs",
        "canonical_rule_ids",
        "binding_refs",
        "criterion_ids",
        "scope",
        "dependencies",
        "acceptance_checks",
        "expected_evidence",
        "score_delta",
        "source_limitations"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "const": "proposed"
        },
        "primary_scenario": {
          "enum": [
            "create",
            "develop",
            "play_now"
          ]
        },
        "layer": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ]
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "canonical_rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binding_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "criterion_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score_delta": {
          "type": [
            "number",
            "null",
            "string"
          ]
        }
      },
      "additionalProperties": true
    },
    "run_result": {
      "type": "object",
      "required": [
        "run_id",
        "selected_task",
        "selection_reason",
        "alternatives",
        "inputs_and_versions",
        "findings",
        "changed_refs",
        "rating_proposal_refs",
        "product_task_refs",
        "verification",
        "automation_health",
        "checkpoint",
        "next_candidate"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "selected_task": {
          "type": "object"
        },
        "selection_reason": {
          "type": "string"
        },
        "alternatives": {
          "type": "array"
        },
        "inputs_and_versions": {
          "type": "object"
        },
        "findings": {
          "type": "array"
        },
        "changed_refs": {
          "type": "array"
        },
        "rating_proposal_refs": {
          "type": "array"
        },
        "product_task_refs": {
          "type": "array"
        },
        "verification": {
          "type": "object"
        },
        "automation_health": {
          "type": "object"
        },
        "checkpoint": {
          "type": [
            "object",
            "null"
          ]
        },
        "next_candidate": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "operational_requirement": {
      "type": "object",
      "required": [
        "source_rule_ref",
        "normative_kind",
        "applicability",
        "layer",
        "trigger_or_user_action",
        "inputs_and_units",
        "product_operation",
        "expected_output",
        "constraints_and_exceptions",
        "acceptance_cases",
        "source_vs_product_interpretation",
        "canonical_rule_refs",
        "unresolved_parameters"
      ],
      "properties": {
        "source_rule_ref": {
          "type": "string"
        },
        "normative_kind": {
          "type": "string"
        },
        "applicability": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ]
        },
        "trigger_or_user_action": {
          "type": "string"
        },
        "inputs_and_units": {
          "type": "object"
        },
        "product_operation": {
          "type": "string"
        },
        "expected_output": {
          "type": "string"
        },
        "constraints_and_exceptions": {
          "type": "array"
        },
        "acceptance_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "given",
              "when",
              "expected"
            ],
            "properties": {
              "given": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              }
            }
          }
        },
        "source_vs_product_interpretation": {
          "type": "string"
        },
        "canonical_rule_refs": {
          "type": "array"
        },
        "unresolved_parameters": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "rule_source_coverage_v2": {
      "type": "object",
      "required": [
        "game_id",
        "edition",
        "declared_corpus",
        "coverage_ledger",
        "unresolved_relevant_refs",
        "completeness_status"
      ],
      "properties": {
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "declared_corpus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_ref",
              "version",
              "full_extent"
            ],
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "full_extent": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "coverage_ledger": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_ref",
              "range_or_section",
              "status",
              "source_rule_ids",
              "reason",
              "evidence_ref"
            ],
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "range_or_section": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "applicable_extracted",
                  "reviewed_not_applicable",
                  "partially_read",
                  "not_read",
                  "unavailable",
                  "open_cross_reference"
                ]
              },
              "source_rule_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "unresolved_relevant_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completeness_status": {
          "enum": [
            "draft",
            "checkpoint",
            "complete_declared_thematic_corpus"
          ]
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "completeness_status": {
                "const": "complete_declared_thematic_corpus"
              }
            },
            "required": [
              "completeness_status"
            ]
          },
          "then": {
            "properties": {
              "unresolved_relevant_refs": {
                "maxItems": 0
              },
              "coverage_ledger": {
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "applicable_extracted",
                        "reviewed_not_applicable"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "rule_analysis_entry_v2": {
      "type": "object",
      "required": [
        "id",
        "game_id",
        "edition",
        "source_rule",
        "layer",
        "operational_requirement",
        "canonical_mapping",
        "implementation",
        "owner_decision_refs",
        "open_decisions",
        "backlog_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "source_rule": {
          "type": "object",
          "required": [
            "source_ref",
            "locator",
            "self_contained_rule",
            "normative_kind",
            "parameters_and_units",
            "conditions",
            "exceptions",
            "cross_references"
          ],
          "properties": {
            "source_ref": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "self_contained_rule": {
              "type": "string",
              "minLength": 20
            },
            "normative_kind": {
              "enum": [
                "mandatory_rule",
                "recommendation",
                "optional_variant",
                "adventure_example",
                "flavour",
                "owner_decision"
              ]
            },
            "parameters_and_units": {
              "type": "object"
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exceptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cross_references": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "layer": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ]
        },
        "operational_requirement": {
          "$ref": "#/$defs/operational_requirement"
        },
        "canonical_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "binding_ref",
              "disposition",
              "semantic_comparison",
              "profile_differences"
            ],
            "properties": {
              "rule_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "binding_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "disposition": {
                "enum": [
                  "reuse",
                  "new_distinct_mechanic",
                  "pending"
                ]
              },
              "semantic_comparison": {
                "type": "string",
                "minLength": 1
              },
              "profile_differences": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "implementation": {
          "type": "object",
          "required": [
            "status",
            "mode",
            "comment",
            "verified_parts",
            "missing_or_unverified_parts",
            "release_sha",
            "method",
            "evidence_refs"
          ],
          "properties": {
            "status": {
              "enum": [
                "full",
                "partial",
                "absent",
                "unverified"
              ]
            },
            "mode": {
              "enum": [
                "manual_existing_tools",
                "automatic_feature",
                "both",
                "unknown"
              ]
            },
            "comment": {
              "type": "string",
              "minLength": 1
            },
            "verified_parts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missing_or_unverified_parts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "release_sha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "full",
                      "partial",
                      "absent"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "release_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "evidence_refs": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "partial"
                  }
                }
              },
              "then": {
                "properties": {
                  "verified_parts": {
                    "minItems": 1
                  },
                  "missing_or_unverified_parts": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "full"
                  }
                }
              },
              "then": {
                "properties": {
                  "missing_or_unverified_parts": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        },
        "owner_decision_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "backlog_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "rule_analysis_quality_report_v2": {
      "type": "object",
      "required": [
        "standard_ref",
        "game_id",
        "edition",
        "source_inventory_ref",
        "analysis_ref",
        "reviewed_sha",
        "reviewer",
        "overall_status",
        "checks",
        "remaining_work"
      ],
      "properties": {
        "standard_ref": {
          "const": "agent-work/research/rule-analysis-standard.md"
        },
        "game_id": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "source_inventory_ref": {
          "type": "string",
          "minLength": 1
        },
        "analysis_ref": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "overall_status": {
          "enum": [
            "not_reviewed",
            "draft",
            "checkpoint",
            "accepted"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {
            "type": "object",
            "required": [
              "criterion_id",
              "result",
              "comment",
              "evidence_refs",
              "exact_continuation"
            ],
            "properties": {
              "criterion_id": {
                "enum": [
                  "RA-Q01",
                  "RA-Q02",
                  "RA-Q03",
                  "RA-Q04",
                  "RA-Q05",
                  "RA-Q06",
                  "RA-Q07",
                  "RA-Q08",
                  "RA-Q09",
                  "RA-Q10",
                  "RA-Q11",
                  "RA-Q12",
                  "RA-Q13",
                  "RA-Q14",
                  "RA-Q15"
                ]
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "blocked",
                  "not_reviewed",
                  "not_applicable"
                ]
              },
              "comment": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exact_continuation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "result": {
                      "const": "pass"
                    }
                  },
                  "required": [
                    "result"
                  ]
                },
                "then": {
                  "properties": {
                    "evidence_refs": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "RA-Q01"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "RA-Q02"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "RA-Q03"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "RA-Q04"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "RA-Q05"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "RA-Q06"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "criterion_id"
                ],
                "properties": {
                  "criterion_id": {
                    "const": "RA-Q07"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
