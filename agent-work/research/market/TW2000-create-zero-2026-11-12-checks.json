  "verification_source_code": {
    "language": "JavaScript",
    "rankMap": "function rankMap(a){return Object.fromEntries(a.map(x=>[x.id,1+a.filter(y=>y.v>x.v).length+(a.filter(y=>y.v===x.v).length-1)/2]));}",
    "baselineCalculator": "function calc(name,p){const rows=r.rows.flatMap(x=>{let s=x.scenarios?.find(z=>z.name===name);if(!s)return[];let d=[...s.D];if(x.id===\"TW2000\"&&p!==undefined)d[0]=s.M*p*s.T;return[{id:x.id,D:d}];});const axes=[0,1,2].map(i=>rankMap(rows.filter(x=>Number.isFinite(x.D[i])).map(x=>({id:x.id,v:x.D[i]}))));const complete=rows.filter(x=>x.D.length===3&&x.D.every(Number.isFinite));const oa=[0,1,2].map(i=>rankMap(complete.map(x=>({id:x.id,v:x.D[i]}))));const means=complete.map(x=>({id:x.id,v:-(oa[0][x.id]+oa[1][x.id]+oa[2][x.id])/3}));const op=rankMap(means);return{rows,axes,oa,op,means,cohorts:Object.fromEntries([5,10,20].map(n=>[n,complete.filter(x=>op[x.id]<=n).sort((x,y)=>op[x.id]-op[y.id]||x.id.localeCompare(y.id)).map(x=>x.id)]))};}",
    "directDCalculator": "function directD(name,D){const rows=r.rows.flatMap(x=>{const s=x.scenarios?.find(z=>z.name===name);if(!s)return[];const d=[...s.D];if(x.id===\"TW2000\")d[0]=D;return[{id:x.id,D:d}];});const axes=[0,1,2].map(i=>rankMap(rows.filter(x=>Number.isFinite(x.D[i])).map(x=>({id:x.id,v:x.D[i]}))));const complete=rows.filter(x=>x.D.length===3&&x.D.every(Number.isFinite));const oa=[0,1,2].map(i=>rankMap(complete.map(x=>({id:x.id,v:x.D[i]}))));const op=rankMap(complete.map(x=>({id:x.id,v:-(oa[0][x.id]+oa[1][x.id]+oa[2][x.id])/3})));return{axes,oa,op,sets:Object.fromEntries([5,10,20].map(n=>[n,complete.filter(x=>op[x.id]<=n).sort((a,b)=>op[a.id]-op[b.id]||a.id.localeCompare(b.id)).map(x=>x.id)]))};}"
  },
  "reproduction_inputs": "Load baseline JSON as variable r; evaluate supplied rankMap/baselineCalculator/directDCalculator in the same scope. For each low/reference/high compare all finite stored ranks and overall_place. Inject case D only for TW2000."
}
